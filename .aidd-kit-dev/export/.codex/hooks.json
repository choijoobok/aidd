{
  "description": "AIDD 정합성 게이트입니다. /hooks에서 이 저장소 훅을 검토하고 신뢰 대상으로 승인하세요.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env node \"$(git rev-parse --show-toplevel)/.ai/tools/aidd.mjs\" project-init",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"node (Join-Path (git rev-parse --show-toplevel) '.ai\\tools\\aidd.mjs') project-init\"",
            "timeout": 30,
            "statusMessage": "AIDD 프로젝트를 안전하게 초기화하는 중"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env node \"$(git rev-parse --show-toplevel)/.ai/tools/aidd_hook.mjs\" session-brief",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"node (Join-Path (git rev-parse --show-toplevel) '.ai\\tools\\aidd_hook.mjs') session-brief\"",
            "timeout": 30,
            "statusMessage": "AIDD 현재 상태를 불러오는 중",
            "additionalContextLimit": 9000
          },
          {
            "type": "command",
            "command": "/usr/bin/env node \"$(git rev-parse --show-toplevel)/.ai/tools/aidd_hook.mjs\" self-test --hook",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"node (Join-Path (git rev-parse --show-toplevel) '.ai\\tools\\aidd_hook.mjs') self-test --hook\"",
            "timeout": 20,
            "statusMessage": "AIDD 하네스 배선을 검사하는 중",
            "additionalContextLimit": 4000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|NotebookEdit|^mcp__.*__(?:write|edit|move|create)",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env node \"$(git rev-parse --show-toplevel)/.ai/tools/aidd_hook.mjs\" protect --platform codex --kind file",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"node (Join-Path (git rev-parse --show-toplevel) '.ai\\tools\\aidd_hook.mjs') protect --platform codex --kind file\"",
            "timeout": 20,
            "statusMessage": "AIDD 파생물 쓰기 정책을 확인하는 중"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|^mcp__.*__(?:start_process|execute_command|run_command|run_shell_command|shell_exec|bash|terminal|exec)",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env node \"$(git rev-parse --show-toplevel)/.ai/tools/aidd_hook.mjs\" protect --platform codex --kind shell",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"node (Join-Path (git rev-parse --show-toplevel) '.ai\\tools\\aidd_hook.mjs') protect --platform codex --kind shell\"",
            "timeout": 20,
            "statusMessage": "AIDD 파괴 명령과 셸 쓰기를 확인하는 중"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|NotebookEdit|Bash|PowerShell|^mcp__.*__(?:write|edit|move|create|start_process|execute_command|run_command|run_shell_command|shell_exec|bash|terminal|exec)",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env node \"$(git rev-parse --show-toplevel)/.ai/tools/aidd_hook.mjs\" post-check --platform codex",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"node (Join-Path (git rev-parse --show-toplevel) '.ai\\tools\\aidd_hook.mjs') post-check --platform codex\"",
            "timeout": 30,
            "statusMessage": "AIDD 파생물과 정본 정합성을 확인하는 중",
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env node \"$(git rev-parse --show-toplevel)/.ai/tools/aidd_hook.mjs\" local-log --platform codex --role user",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"node (Join-Path (git rev-parse --show-toplevel) '.ai\\tools\\aidd_hook.mjs') local-log --platform codex --role user\"",
            "timeout": 10,
            "statusMessage": "로컬 대화 기록을 저장하는 중"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env node \"$(git rev-parse --show-toplevel)/.ai/tools/aidd.mjs\" hook --platform codex --event Stop",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"node (Join-Path (git rev-parse --show-toplevel) '.ai\\tools\\aidd.mjs') hook --platform codex --event Stop\"",
            "timeout": 30,
            "statusMessage": "AIDD 정합성을 검사하는 중"
          },
          {
            "type": "command",
            "command": "/usr/bin/env node \"$(git rev-parse --show-toplevel)/.ai/tools/aidd_hook.mjs\" local-log --platform codex --role assistant",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"node (Join-Path (git rev-parse --show-toplevel) '.ai\\tools\\aidd_hook.mjs') local-log --platform codex --role assistant\"",
            "timeout": 10,
            "statusMessage": "로컬 대화 기록을 저장하는 중"
          }
        ]
      }
    ]
  }
}
