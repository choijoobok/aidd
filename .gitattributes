# 플랫폼과 관계없이 정본·문서·스크립트의 줄바꿈을 LF로 유지한다.
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.mjs text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.githooks/* text eol=lf

# 원시 evidence 로그는 기록 당시 바이트와 SHA-256을 그대로 보존한다.
.aidd-kit-dev/evidence/*-logs/*.log -text
.aidd-kit-dev/evidence/*-logs/*.tap -text
