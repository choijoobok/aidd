{
  "description": "AIDD hooks: isolated session context, generated-output protection, terminology follow-up, and unified local conversation logging.",
  "hooks": {
    "SessionStart": [{"matcher":"startup|resume|clear|compact","hooks":[
      {"type":"command","command":"node .ai/hooks/codex-session-brief.mjs","commandWindows":"node .ai\\hooks\\codex-session-brief.mjs","timeout":15,"statusMessage":"AIDD session brief"},
      {"type":"command","command":"node .ai/hooks/codex-hook-review-reminder.mjs","commandWindows":"node .ai\\hooks\\codex-hook-review-reminder.mjs","timeout":15,"statusMessage":"AIDD Codex hook review reminder","additionalContextLimit":1000}
    ]}],
    "PreToolUse": [
      {"matcher":"apply_patch|Edit|Write|NotebookEdit|^mcp__.*__(?:write|edit|move|create)","hooks":[{"type":"command","command":"node .ai/hooks/codex-protect-file.mjs","commandWindows":"node .ai\\hooks\\codex-protect-file.mjs","timeout":15,"statusMessage":"AIDD generated-output file protection"}]},
      {"matcher":"Bash|PowerShell|^mcp__.*__(?:start_process|execute_command|run_command|run_shell_command|shell_exec|bash|terminal|exec)","hooks":[{"type":"command","command":"node .ai/hooks/codex-protect-shell.mjs","commandWindows":"node .ai\\hooks\\codex-protect-shell.mjs","timeout":15,"statusMessage":"AIDD generated-output shell protection"}]}
    ],
    "PostToolUse":[{"matcher":"apply_patch|Edit|Write|NotebookEdit|Bash|PowerShell|^mcp__.*__(?:write|edit|move|create|start_process|execute_command|run_command|run_shell_command|shell_exec|bash|terminal|exec)","hooks":[{"type":"command","command":"node .ai/hooks/codex-post-check.mjs","commandWindows":"node .ai\\hooks\\codex-post-check.mjs","timeout":20,"statusMessage":"AIDD post-change check"}]}],
    "UserPromptSubmit":[{"hooks":[{"type":"command","command":"node .ai/hooks/codex-log-user.mjs","commandWindows":"node .ai\\hooks\\codex-log-user.mjs","timeout":10,"statusMessage":"AIDD unified conversation log"}]}],
    "Stop":[{"hooks":[{"type":"command","command":"node .ai/hooks/codex-log-assistant.mjs","commandWindows":"node .ai\\hooks\\codex-log-assistant.mjs","timeout":10,"statusMessage":"AIDD unified conversation log"}]}]
  }
}
