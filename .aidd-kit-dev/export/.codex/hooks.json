{
  "description": "AIDD hooks: session context, generated-output protection, terminology refresh, and local conversation logs.",
  "hooks": {
    "SessionStart": [{"matcher":"startup|resume|clear|compact","hooks":[
      {"type":"command","command":"node .ai/tools/aidd_hook.mjs session-brief","commandWindows":"node .ai\\tools\\aidd_hook.mjs session-brief","timeout":15,"statusMessage":"AIDD session brief"},
      {"type":"command","command":"node .ai/tools/aidd_hook.mjs codex-hook-review-reminder","commandWindows":"node .ai\\tools\\aidd_hook.mjs codex-hook-review-reminder","timeout":15,"statusMessage":"AIDD Codex hook review reminder"},
      {"type":"command","command":"node .ai/tools/aidd_hook.mjs self-test --hook","commandWindows":"node .ai\\tools\\aidd_hook.mjs self-test --hook","timeout":15,"statusMessage":"AIDD hook wiring check"}
    ]}],
    "PreToolUse": [
      {"matcher":"apply_patch|Edit|Write|NotebookEdit|^mcp__.*__(?:write|edit|move|create)","hooks":[{"type":"command","command":"node .ai/tools/aidd_hook.mjs protect --platform codex --kind file","commandWindows":"node .ai\\tools\\aidd_hook.mjs protect --platform codex --kind file","timeout":15,"statusMessage":"AIDD generated-output protection"}]},
      {"matcher":"Bash|PowerShell|^mcp__.*__(?:start_process|execute_command|run_command|run_shell_command|shell_exec|bash|terminal|exec)","hooks":[{"type":"command","command":"node .ai/tools/aidd_hook.mjs protect --platform codex --kind shell","commandWindows":"node .ai\\tools\\aidd_hook.mjs protect --platform codex --kind shell","timeout":15,"statusMessage":"AIDD generated-output protection"}]}
    ],
    "PostToolUse":[{"matcher":"apply_patch|Edit|Write|NotebookEdit|Bash|PowerShell|^mcp__.*__(?:write|edit|move|create|start_process|execute_command|run_command|run_shell_command|shell_exec|bash|terminal|exec)","hooks":[{"type":"command","command":"node .ai/tools/aidd_hook.mjs post-check --platform codex","commandWindows":"node .ai\\tools\\aidd_hook.mjs post-check --platform codex","timeout":20,"statusMessage":"AIDD post-change check"}]}],
    "UserPromptSubmit":[{"hooks":[{"type":"command","command":"node .ai/tools/aidd_hook.mjs local-log --platform codex --role user","commandWindows":"node .ai\\tools\\aidd_hook.mjs local-log --platform codex --role user","timeout":10,"statusMessage":"AIDD local log"}]}],
    "Stop":[{"hooks":[{"type":"command","command":"node .ai/tools/aidd_hook.mjs local-log --platform codex --role assistant","commandWindows":"node .ai\\tools\\aidd_hook.mjs local-log --platform codex --role assistant","timeout":10,"statusMessage":"AIDD local log"}]}]
  }
}
