{
  "version": 1,
  "events": {
    "SessionStart": {
      "purpose": "현재 로컬 Git 작업자, AIDD 상태·협업·통합 위험을 브리핑하고 공통 배선을 점검한다. Codex에서는 훅 신뢰·사용자 승인 게이트 상태도 알린다.",
      "required_tokens": ["session-brief", "self-test"],
      "provider_required_tokens": {
        "codex": ["hook-trust-status", "approval-status"]
      }
    },
    "PreToolUse": {
      "purpose": "생성물 직접 쓰기와 파괴적·우회 셸 쓰기를 사전 보호한다. Codex에서는 사용자 훅 승인 확인 전 일반 작업과 분류되지 않은 도구를 차단하되 계약에 열거된 읽기 전용 도구와 복구 경로는 허용한다.",
      "required_tokens": ["protect", "--kind", "file", "shell"],
      "provider_required_tokens": {
        "codex": ["approval-gate"]
      }
    },
    "PostToolUse": {
      "purpose": "정본·공통 AI 정책 변경 뒤의 드리프트와 제품 소스 변경 뒤 문서 현행화 후보를 경고한다.",
      "required_tokens": ["post-check"]
    },
    "UserPromptSubmit": {
      "purpose": "사용자 원문을 로컬 전용 대화 로그에 기록한다. Codex에서는 명백한 부정·모순·모호성을 거부하는 결정적 의미 분류로 현재 세션의 훅 승인 상태를 전이한다.",
      "required_tokens": ["local-log", "--role", "user"],
      "provider_required_tokens": {
        "codex": ["acknowledge"]
      }
    },
    "Stop": {
      "purpose": "정합성 게이트와 가능한 경우 AI 응답 원문 로컬 기록을 실행한다.",
      "required_tokens": ["aidd.mjs", "hook", "local-log", "--role", "assistant"]
    }
  },
  "git_pre_commit": {
    "purpose": "staged 제품 소스가 시스템 표면과 연결되고 문서가 함께 갱신되었거나 기한 있는 후속 작업이 승인되었는지 검사한다.",
    "command": "node .ai/tools/aidd.mjs documentation-check --staged"
  },
  "node_runtime": {
    "minimum_major": 22,
    "hook_input": "utf-8-bytes",
    "dependencies": "node-standard-library"
  },
  "approval_gate": {
    "platform": "codex",
    "unknown_tool_behavior": "deny",
    "windows_desktop_origin_environment": "CODEX_INTERNAL_ORIGINATOR_OVERRIDE",
    "windows_desktop_origin_value": "Codex Desktop",
    "windows_desktop_package_environment": "CODEX_WINDOWS_SANDBOX_PACKAGE_FAMILY",
    "cli_origin_value": "Codex CLI",
    "cli_origin_absence_means_cli": true,
    "unknown_client_behavior": "require_new_session",
    "composed_shell_command_behavior": "deny",
    "codex_trust_revision_paths": [".codex/hooks.json"],
    "legacy_v2_migration_behavior": "require-confirmation",
    "restart_required_scope": "client-kind",
    "pre_git_export_root_resolution": "session-cwd-relative",
    "pre_git_export_pretool_failure_behavior": "deny",
    "pre_git_export_events": ["SessionStart", "PreToolUse", "PostToolUse", "UserPromptSubmit", "Stop"],
    "windows_desktop_new_approval_requires_new_session": true,
    "cli_new_approval_current_session_effective": true,
    "cli_revision_reapproval_current_session_effective": true,
    "locked_read_only_tools": [
      "web.run",
      "web__run",
      "webrun",
      "read_mcp_resource",
      "list_mcp_resources",
      "list_mcp_resource_templates",
      "view_image"
    ]
  },
  "recovery_paths": [
    ".ai/hooks/policy.json",
    ".ai/hooks/contract.json",
    ".ai/hooks/README.md",
    ".ai/tools/aidd_hook.mjs",
    ".claude/settings.json",
    ".codex/hooks.json",
    ".ai/tests/harness.test.mjs"
  ],
  "local_conversation_log": {
    "root": "chat-history",
    "date_format": "%Y-%m/%Y-%m-%d.md",
    "enabled_by_default": true,
    "max_entry_chars": 16000,
    "max_daily_file_bytes": 5242880,
    "transport_encoding": "utf-8",
    "failure_reporting": "sanitized-stderr",
    "disable_environment": "AIDD_LOCAL_CONVERSATION_LOG=0"
  }
}
