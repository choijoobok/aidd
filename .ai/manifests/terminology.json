  "terms": [
    {"id":"AIDD-TERM-001","term":"AIDD","key":"aidd","name":"AI 주도 개발","category":"방법론","definition":"의도·요구·설계·구현·검증·운영을 구조화된 정본과 증거로 연결해 AI와 사람이 함께 수행하는 개발 방식이다.","aliases":["AI-Driven Development"],"audiences":["project_team","developer","operator"],"visibility":"internal","source":".ai/spec/purpose-and-boundaries.md"},
    {"id":"AIDD-TERM-002","term":"SSOT","key":"ssot","name":"정본","category":"정본","definition":"같은 사실을 한 곳에서만 정의하는 유일한 진실의 원천이다.","aliases":["Single Source of Truth"],"audiences":["project_team","developer","operator"],"visibility":"internal","source":".ai/spec/project-lifecycle.md"},
    {"id":"AIDD-TERM-003","term":"REQ","key":"requirement","name":"요구사항","category":"추적성 ID","definition":"제품이나 시스템이 충족해야 하는 관찰 가능한 요구를 식별한다.","aliases":[],"audiences":["project_team","developer"],"visibility":"internal","source":".ai/spec/project-lifecycle.md"},
    {"id":"AIDD-TERM-004","term":"NFR","key":"nonFunctionalRequirement","name":"비기능 요구사항","category":"추적성 ID","definition":"성능·보안·신뢰성·운영성처럼 기능의 품질 수준과 제약을 식별한다.","aliases":["Non-Functional Requirement"],"audiences":["project_team","developer","operator"],"visibility":"internal","source":".ai/spec/project-lifecycle.md"},
    {"id":"AIDD-TERM-005","term":"MOD","key":"module","name":"모듈","category":"추적성 ID","definition":"책임·정본·인터페이스와 진행 상태를 독립적으로 관리하는 시스템 범위다.","aliases":[],"audiences":["project_team","developer","operator"],"visibility":"internal","source":".ai/spec/project-lifecycle.md"},
    {"id":"AIDD-TERM-006","term":"CHG","key":"change","name":"변경","category":"변경 관리","definition":"문제·의도·범위·위험·검증과 롤백을 함께 추적하는 변경 단위다.","aliases":["변경 요청"],"audiences":["project_team","developer","operator"],"visibility":"internal","source":".ai/spec/change-sharing.md"},
    {"id":"AIDD-TERM-007","term":"ADR","key":"architectureDecisionRecord","name":"결정 기록","category":"의사결정","definition":"중요한 선택의 맥락·대안·결정·결과·롤백을 보존하는 기록이다.","aliases":["Architecture Decision Record"],"audiences":["project_team","developer","operator"],"visibility":"internal","source":".ai/spec/project-lifecycle.md"},
    {"id":"AIDD-TERM-008","term":"OI","key":"openItem","name":"미결 항목","category":"의사결정","definition":"답이나 조치가 남아 있어 추적해야 하는 질문·결정·작업이다.","aliases":["Open Item"],"audiences":["project_team","developer","operator"],"visibility":"internal","source":".ai/spec/project-lifecycle.md"},
    {"id":"AIDD-TERM-009","term":"ASM","key":"assumption","name":"가정","category":"의사결정","definition":"검증되지 않았지만 임시로 참으로 두며 확인 기한과 영향을 추적하는 전제다.","aliases":["Assumption"],"audiences":["project_team","developer","operator"],"visibility":"internal","source":".ai/spec/project-lifecycle.md"},
    {"id":"AIDD-TERM-010","term":"RSK","key":"risk","name":"위험","category":"거버넌스","definition":"발생 가능성과 영향, 완화·수용 여부를 관리하는 불확실한 사건이다.","aliases":["Risk"],"audiences":["project_team","developer","operator"],"visibility":"internal","source":".ai/spec/project-lifecycle.md"},
    {"id":"AIDD-TERM-011","term":"TST","key":"test","name":"테스트","category":"검증","definition":"요구와 계약이 실제로 충족되는지 실행 가능한 조건과 결과로 확인하는 항목이다.","aliases":["테스트 케이스"],"audiences":["project_team","developer"],"visibility":"internal","source":".ai/spec/conformance.md"},
    {"id":"AIDD-TERM-012","term":"EVD","key":"evidence","name":"증거","category":"검증","definition":"누가 언제 어떤 환경과 명령으로 무엇을 확인했는지 입증하는 실행·검토 기록이다.","aliases":["Evidence"],"audiences":["project_team","developer","operator"],"visibility":"internal","source":".ai/spec/conformance.md"},
    {"id":"AIDD-TERM-013","term":"GTR","key":"gateRun","name":"게이트 실행","category":"게이트","definition":"특정 변경이나 범위에 대해 게이트 기준별 판정과 증거를 남긴 실행 기록이다.","aliases":["Gate Run"],"audiences":["project_team","developer","operator"],"visibility":"internal","source":".ai/spec/project-lifecycle.md"},
    {"id":"AIDD-TERM-014","term":"WRK","key":"workItem","name":"작업 항목","category":"계획","definition":"담당·선행 조건·완료 조건·증거를 가진 수행 단위다.","aliases":["Work Item"],"audiences":["project_team","developer"],"visibility":"internal","source":".ai/spec/project-lifecycle.md"},
    {"id":"AIDD-TERM-015","term":"MLS","key":"milestone","name":"마일스톤","category":"계획","definition":"여러 작업과 결과를 묶어 일정과 완료 조건을 추적하는 이정표다.","aliases":["Milestone"],"audiences":["project_team","developer"],"visibility":"internal","source":".ai/spec/project-lifecycle.md"},
    {"id":"AIDD-TERM-016","term":"IFC","key":"interfaceContract","name":"인터페이스 계약","category":"아키텍처","definition":"모듈이나 외부 시스템 사이의 입력·출력·호환성·실패 동작을 정의한다.","aliases":["Interface Contract"],"audiences":["project_team","developer","operator"],"visibility":"internal","source":".ai/spec/project-lifecycle.md"},
    {"id":"AIDD-TERM-017","term":"DPN","key":"dependency","name":"의존성","category":"아키텍처","definition":"한 모듈·작업·계약이 다른 대상에 기대는 방향과 조건을 기록한다.","aliases":["Dependency"],"audiences":["project_team","developer","operator"],"visibility":"internal","source":".ai/spec/project-lifecycle.md"},
    {"id":"AIDD-TERM-018","term":"SURF","key":"systemSurface","name":"시스템 표면","category":"문서화","definition":"화면·API·배치·이벤트·연동처럼 사용자나 다른 시스템이 접하는 구현 표면이다.","aliases":["System Surface"],"audiences":["project_team","developer","operator"],"visibility":"internal","source":".ai/spec/project-lifecycle.md"},
    {"id":"AIDD-TERM-019","term":"SCR","key":"screen","name":"화면","category":"UI","definition":"사용자 진입점과 상태·행동·접근성 계약을 가진 화면 명세다.","aliases":["Screen"],"audiences":["project_team","developer"],"visibility":"internal","source":".ai/spec/project-lifecycle.md"},
    {"id":"AIDD-TERM-020","term":"MAN","key":"manual","name":"사용자 절차","category":"사용자 문서","definition":"사용자가 업무를 완료하도록 사전 조건·단계·예상 결과·복구를 설명하는 절차다.","aliases":["Manual"],"audiences":["project_team","developer","operator"],"visibility":"internal","source":".ai/spec/project-lifecycle.md"},
    {"id":"AIDD-TERM-021","term":"DLP","key":"deliveryProfile","name":"전달 프로필","category":"제출","definition":"독자별 산출물 포함·제외·검증·공개 범위를 정의하는 제출 정책이다.","aliases":["Delivery Profile"],"audiences":["project_team","developer","operator"],"visibility":"internal","source":".ai/spec/distribution-layout.md"},
    {"id":"AIDD-TERM-022","term":"GPH","key":"goldenPath","name":"골든 패스","category":"개발 기반","definition":"대표 기능을 안전하게 구현·검증하는 권장 절차와 예시다.","aliases":["Golden Path"],"audiences":["developer"],"visibility":"internal","source":".ai/spec/project-lifecycle.md"},
    {"id":"AIDD-TERM-023","term":"STD","key":"standard","name":"개발 표준","category":"개발 기반","definition":"코드·오류·보안·테스트·관측성·배포에 반복 적용하는 기준이다.","aliases":["Standard"],"audiences":["developer","operator"],"visibility":"internal","source":".ai/spec/project-lifecycle.md"},
    {"id":"AIDD-TERM-024","term":"UXB","key":"uxBaseline","name":"UX 기준선","category":"UI","definition":"사용자 여정·정보 구조·접근성·레이아웃의 공통 결정 기준이다.","aliases":["UX Baseline"],"audiences":["project_team","developer"],"visibility":"internal","source":".ai/spec/project-lifecycle.md"},
    {"id":"AIDD-TERM-025","term":"UIP","key":"uiPattern","name":"UI 패턴","category":"UI","definition":"여러 화면에서 재사용하는 상호작용과 상태 표현 규칙이다.","aliases":["UI Pattern"],"audiences":["project_team","developer"],"visibility":"internal","source":".ai/spec/project-lifecycle.md"},
    {"id":"AIDD-TERM-026","term":"CMP","key":"component","name":"공통 컴포넌트","category":"UI","definition":"현재 유효한 계약과 상태를 갖고 여러 화면에서 재사용하는 UI 구성 요소다.","aliases":["Component"],"audiences":["developer"],"visibility":"internal","source":".ai/spec/project-lifecycle.md"},
    {"id":"AIDD-TERM-027","term":"MRG","key":"merge","name":"병합 기록","category":"통합","definition":"병합 커밋의 부모·변경·충돌 해결·영향 평가를 보존하는 기록이다.","aliases":["Merge Record"],"audiences":["project_team","developer"],"visibility":"internal","source":".ai/spec/project-lifecycle.md"},
    {"id":"AIDD-TERM-028","term":"MRC","key":"mergeRecheck","name":"병합 후 재검토","category":"통합","definition":"병합 영향으로 다시 수행해야 하는 검토나 테스트 항목이다.","aliases":["Merge Recheck"],"audiences":["project_team","developer"],"visibility":"internal","source":".ai/spec/project-lifecycle.md"},
    {"id":"AIDD-TERM-029","term":"C0","key":"changeClass0","name":"경미한 변경","category":"변경 등급","definition":"의미·계약·실행 동작에 영향을 주지 않는 낮은 위험의 변경 등급이다.","aliases":[],"audiences":["project_team","developer"],"visibility":"internal","source":".ai/spec/project-lifecycle.md"},
    {"id":"AIDD-TERM-030","term":"C1","key":"changeClass1","name":"국소 변경","category":"변경 등급","definition":"영향 범위가 제한적이고 기존 계약을 유지하는 변경 등급이다.","aliases":[],"audiences":["project_team","developer"],"visibility":"internal","source":".ai/spec/project-lifecycle.md"},
    {"id":"AIDD-TERM-031","term":"C2","key":"changeClass2","name":"중요 변경","category":"변경 등급","definition":"여러 산출물·계약 또는 사용자 동작에 영향을 주어 독립 검토가 필요한 변경 등급이다.","aliases":[],"audiences":["project_team","developer","operator"],"visibility":"internal","source":".ai/spec/conformance.md"},
    {"id":"AIDD-TERM-032","term":"C3","key":"changeClass3","name":"중대 변경","category":"변경 등급","definition":"광범위하거나 되돌리기 어렵고 높은 위험을 가져 강화된 검증과 독립 검토가 필요한 변경 등급이다.","aliases":[],"audiences":["project_team","developer","operator"],"visibility":"internal","source":".ai/spec/conformance.md"},
    {"id":"AIDD-TERM-033","term":"게이트","key":"gate","name":"게이트","category":"게이트","definition":"다음 단계로 진행하기 전에 기준과 증거의 충족 여부를 확인하는 통제 지점이다.","aliases":["Gate"],"audiences":["project_team","developer","operator"],"visibility":"internal","source":".ai/spec/project-lifecycle.md"},
    {"id":"AIDD-TERM-034","term":"정본","key":"canonicalRecord","name":"정본","category":"정본","definition":"현재 유효한 사실과 의도를 기계가 읽을 수 있게 보존하는 원본 기록이다.","aliases":["Canonical Record"],"audiences":["project_team","developer","operator"],"visibility":"internal","source":".ai/spec/project-lifecycle.md"},
    {"id":"AIDD-TERM-035","term":"파생물","key":"generatedArtifact","name":"파생물","category":"정본","definition":"정본에서 결정적으로 다시 만들 수 있으며 직접 수정하지 않는 문서나 결과물이다.","aliases":["Generated Artifact"],"audiences":["project_team","developer","operator"],"visibility":"internal","source":".ai/spec/conformance.md"},
    {"id":"AIDD-TERM-038","term":"TRM","key":"projectTerm","name":"프로젝트 용어","category":"용어 관리","definition":"프로젝트가 영향 검토와 자체 결정 절차를 거쳐 현재 사용하도록 정의한 업무·제품·기술 개념이다.","aliases":["Project Term"],"audiences":["project_team","developer","operator"],"visibility":"internal","source":".ai/spec/project-lifecycle.md"},
    {"id":"AIDD-TERM-039","term":"TCH","key":"terminologyChangeHistory","name":"용어 변경 이력","category":"용어 관리","definition":"프로젝트가 결정한 용어 추가·변경·제거의 전후 값, 결정 주체, 영향 범위, 적용 결과와 검증을 보존하는 이력이다.","aliases":["Terminology Change History"],"audiences":["project_team","developer","operator"],"visibility":"internal","source":".ai/spec/project-lifecycle.md"},
    {"id":"AIDD-TERM-040","term":"HIS","key":"decisionHistory","name":"결정 이력","category":"정본","definition":"중요한 분석·설계·용어·소스·범위·상태 결정의 주체, 내용, 이유, 이전 상태, 영향과 출처를 안정 ID에 연결해 append-only로 보존하는 기록이다.","aliases":["Decision History"],"audiences":["project_team","developer","operator"],"visibility":"internal","source":".ai/docs/methodology/artifact-model.md"}
  ]
