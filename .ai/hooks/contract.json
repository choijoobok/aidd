{
  "version": 3,
  "events": {
    "SessionStart": {
      "purpose": "현재 AIDD 역할을 브리핑하고 공통 훅 배선을 점검한다.",
      "required_tokens": ["session-brief", "self-test"]
    },
    "PreToolUse": {
      "purpose": "생성물과 provider 스킬 복사본의 직접 수정을 막고 정본 또는 생성기를 안내한다.",
      "required_tokens": ["protect"]
    },
    "PostToolUse": {
      "purpose": "용어 정본 직접 변경 뒤 파생 문서 현행화를 보조하고 스킬 변경 뒤 역할별 provider 동기화를 안내한다. 정상 PM 용어 변경은 term-apply가 생성·검증까지 수행한다.",
      "required_tokens": ["post-check"]
    },
    "UserPromptSubmit": {
      "purpose": "사용자 원문을 선택 가능한 로컬 전용 대화 로그에 기록한다.",
      "required_tokens": ["local-log", "--role", "user"]
    },
    "Stop": {
      "purpose": "가능한 경우 AI 응답 원문을 로컬 전용 대화 로그에 기록한다.",
      "required_tokens": ["local-log", "--role", "assistant"]
    }
  },
  "provider_events": {
    "codex": {
      "SessionStart": {
        "purpose": "Codex 사용자에게 CLI /hooks에서 현재 작업공간 훅을 검토하고 신뢰 처리했는지 확인하도록 눈에 띄는 경고를 표시한다.",
        "required_tokens": ["codex-hook-review-reminder"]
      }
    },
    "claude": {
      "SessionStart": {
        "forbidden_tokens": ["codex-hook-review-reminder"]
      }
    }
  },
  "terminology_refresh": {
    "trigger_path": "project/.aidd/ssot/terminology.json",
    "command": "node .ai/tools/aidd.mjs terminology-refresh",
    "failure_behavior": "warn"
  },
  "skill_sync_guidance": {
    "kit-source": {
      "trigger_paths": [".ai/skills/", ".aidd-kit-dev/skills/"],
      "command": "node .aidd-kit-dev/tools/kit.mjs sync-providers"
    },
    "kit-template": {
      "trigger_paths": [".ai/skills/"],
      "command": "node .ai/tools/aidd.mjs sync-ai"
    },
    "product-workspace": {
      "trigger_paths": [".ai/skills/"],
      "command": "node .ai/tools/aidd.mjs sync-ai"
    },
    "failure_behavior": "warn"
  },
  "node_runtime": {
    "minimum_major": 22,
    "hook_input": "utf-8-bytes",
    "dependencies": "node-standard-library"
  },
  "local_conversation_log": {
    "root": "chat-history",
    "date_format": "%Y-%m/%Y-%m-%d.md",
    "enabled_by_default": true,
    "max_entry_chars": 16000,
    "max_daily_file_bytes": 5242880,
    "failure_reporting": "sanitized-stderr",
    "disable_environment": "AIDD_LOCAL_CONVERSATION_LOG=0"
  }
}
